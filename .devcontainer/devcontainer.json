{
  "name": "task-planner-comfort",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Next.js Dev Server",
      "onAutoForward": "openBrowser"
    }
  },
  "postStartCommand": "npm install && (lsof -ti:3000 | xargs -r kill) && nohup npm run dev >/tmp/task-planner-dev.log 2>&1 &"
}
